{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=LeaveRequests;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "LeaveRequestsApi",
    "Audience": "LeaveRequestsClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshCookieName": "refresh_token",
    "RefreshCookiePath": "/api/auth"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
